DJANGO_SECRET_KEY=replace-with-a-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# 通过 IP 或域名访问时必须填，否则登录等 POST 会被 CSRF 拦下（含端口，带协议）
DJANGO_CSRF_TRUSTED_ORIGINS=http://192.168.1.10:8000
BACKUP_DIRECTORY=backups

# 应用日志目录，按天轮转保留 30 天。app.log 是全部日志，mail.log 只记发信。
# Docker 部署要指向 /app/data/logs：容器内以 uid 10001 运行，而宿主机挂载目录
# 通常归部署用户所有，单独挂一个 logs 卷会因属主不同而不可写，Django 直接起不来。
# 放在已经可写的 data 卷下，同样持久化且不依赖宿主机权限。
LOG_DIRECTORY=logs
# 需要排查细节时临时改成 DEBUG
DJANGO_LOG_LEVEL=INFO

# 会话有效期（秒），默认 12 小时。上 HTTPS 后再考虑开
# SECURE_SSL_REDIRECT / SESSION_COOKIE_SECURE / CSRF_COOKIE_SECURE。
SESSION_COOKIE_AGE=43200

# 阿里云企业邮箱 SMTP（发信地址必须与登录账号一致）
EMAIL_HOST=smtp.qiye.aliyun.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=report@yourdomain.com
EMAIL_HOST_PASSWORD=replace-with-mailbox-password
DEFAULT_FROM_EMAIL=report@yourdomain.com
